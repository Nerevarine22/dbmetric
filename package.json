{
  "name": "metric-users",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "sync": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sync:watch": "node --import tsx src/watch.ts",
    "snapshot:check": "node --import tsx src/checkSnapshot.ts",
    "refresh:publish": "node --env-file-if-exists=.env --import tsx src/refresh.ts",
    "backup": "node --env-file-if-exists=.env --import tsx src/cli.ts --backup",
    "sync:lp": "node --env-file-if-exists=.env --import tsx src/lp/cli.ts"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.39.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
